{
  "name": "@arclockproject/common",
  "version": "1.2.0",
  "author": "ArcLock Project",
  "description": "Common reusable components and library utils.",
  "homepage": "https://arclockproject.org/docs/common/",
  "bugs": {
    "url": "https://github.com/arclockproject/mono/issues"
  },
  "keywords": [
    "react",
    "library",
    "react-component",
    "typescript"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arclockproject/mono.git",
    "directory": "package/common"
  },
  "scripts": {
    "build": "NODE_ENV=production tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "pnpm simple-git-hooks",
    "release": "bumpp --commit --push --tag",
    "type-check": "tsc --noEmit",
    "vite": "vite"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@eslint/js": "^9.33.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "bumpp": "^10.4.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.11",
    "vite-tsconfig-paths": "^6.0.5"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/x-tree-view": "^8.0.0",
    "@toolpad/core": "^0.16.0",
    "@webtoon/psd": "^0.4.0",
    "lodash": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "typescript": ">=4.5.0",
    "wanakana": "^5.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./library/*": {
      "import": {
        "types": "./dist/library/*/index.d.ts",
        "default": "./dist/library/*/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./components/*": {
      "import": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "engines": {
    "node": ">=20.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint && pnpm run type-check"
  },
  "types": "./dist/index.d.ts"
}
